image <IMAGE_NAME>.<IMAGE_SUFFIX>.sparse {
   android-sparse {
      image = <IMAGE_NAME>.<IMAGE_SUFFIX>
   }
}

image boot.vfat.sparse {
   android-sparse {
      image = boot.vfat
   }
}

image system_a.ext4.sparse {
   android-sparse {
      image = system_a.ext4
   }
}

image system_b.ext4.sparse {
   android-sparse {
      image = system_b.ext4
   }
}

image persistent.ext4.sparse {
   android-sparse {
      image = persistent.ext4
   }
}

image uboot-env-primary.bin.sparse {
   android-sparse {
      image = uboot-env-primary.bin
   }
}

image uboot-env-redundant.bin.sparse {
   android-sparse {
      image = uboot-env-redundant.bin
   }
}

image uboot-env-primary.bin {
   file {
      holes = {}
   }
}

image uboot-env-redundant.bin {
   file {
      holes = {}
   }
}

image <IMAGE_NAME>.<IMAGE_SUFFIX> {
   hdimage {
      align = 8M
      partition-table-type = "mbr"
      fill = true
      disk-signature = "<DISK_SIGNATURE>"
   }

   partition uboot_env_primary {
      in-partition-table = false
      offset = 1M
      image = "uboot-env-primary.bin"
   }

   partition uboot_env_redundant {
      in-partition-table = false
      offset = 4M
      image = "uboot-env-redundant.bin"
   }

   partition boot {
      in-partition-table = true
      partition-type = 0xC
      image = boot.vfat
      bootable = true
   }

   partition system_a {
      in-partition-table = true
      partition-type = 0x83
      image = system_a.ext4
   }

   partition system_b {
      in-partition-table = true
      partition-type = 0x83
      image = system_b.ext4
   }

   partition persistent {
      in-partition-table = true
      partition-type = 0x83
      image = persistent.ext4
   }
}

image boot.vfat {
   vfat {
      label = "BOOT"
      extraargs = "<VFAT_EXTRAARGS>"
   }
   size = <BOOT_SIZE>
   mountpoint = "/boot/firmware"
   exec-pre = "<SETUP> BOOT"
}

image system_a.ext4 {
   ext4 {
      label = "SYSTEM_A"
      use-mke2fs = true
      mke2fs-conf = <MKE2FS_CONF>
      extraargs = "<SYSTEM_A_EXTRAARGS>"
   }
   size = <SYSTEM_SIZE>
   mountpoint = "/"
   exec-pre = "<SETUP> SYSTEM"
}

image system_b.ext4 {
   ext4 {
      label = "SYSTEM_B"
      use-mke2fs = true
      mke2fs-conf = <MKE2FS_CONF>
      extraargs = "<SYSTEM_B_EXTRAARGS>"
   }
   size = <SYSTEM_SIZE>
   mountpoint = "/"
   exec-pre = "<SETUP> SYSTEM"
}

image persistent.ext4 {
   ext4 {
      label = "PERSISTENT"
      use-mke2fs = true
      mke2fs-conf = <MKE2FS_CONF>
      extraargs = "<DATA_EXTRAARGS>"
   }
   size = <DATA_SIZE>
   mountpoint = "/persistent"
}
