# MasjidPi Raspberry Pi 3 A/B environment

stdin=serial,usbkbd
stdout=serial,vidconsole
stderr=serial,vidconsole
baudrate=115200
bootdelay=2
preboot=usb start

fdt_high=ffffffffffffffff
initrd_high=ffffffffffffffff
kernel_addr_r=0x00080000
scriptaddr=0x02400000
pxefile_addr_r=0x02500000
fdt_addr_r=0x02600000
ramdisk_addr_r=0x02700000

active_slot=a
rollback_slot=a
upgrade_available=0
bootcount=0

boot_selected_slot=echo Booting MasjidPi system ${active_slot}; sysboot mmc 0:1 any ${pxefile_addr_r} /extlinux/system_${active_slot}.conf; echo Slot boot failed; reset
bootcmd=run boot_selected_slot
altbootcmd=echo Boot limit exceeded - rolling back to system ${rollback_slot}; setenv active_slot ${rollback_slot}; setenv upgrade_available 0; setenv bootcount 0; setenv bootlimit; saveenv; run boot_selected_slot
