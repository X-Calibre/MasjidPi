# MasjidPi Raspberry Pi 3 A/B U-Boot configuration

# CONFIG_ENV_IS_IN_FAT is not set
CONFIG_ENV_IS_IN_MMC=y
CONFIG_ENV_OFFSET=0x00100000
CONFIG_ENV_OFFSET_REDUND=0x00400000
CONFIG_ENV_SIZE=0x00004000
CONFIG_SYS_REDUNDAND_ENVIRONMENT=y

CONFIG_BOOTCOUNT_LIMIT=y
CONFIG_BOOTCOUNT_ENV=y
CONFIG_BOOTCOUNT_BOOTLIMIT=2

CONFIG_CMD_SYSBOOT=y
CONFIG_USE_DEFAULT_ENV_FILE=y
CONFIG_DEFAULT_ENV_FILE="board/raspberrypi/rpi/masjidpi.env"
