#!/bin/bash

set -euo pipefail
export PATH="/usr/local/sbin:/usr/sbin:/sbin:$PATH"

public_key=$(
    realpath "${MASJIDPI_UPDATE_PUBLIC_KEY:-/usr/share/masjidpi/update/masjidpi-update.pub}"
)
readonly public_key
readonly appliance_user=masjidframe

usage()
{
    echo "Usage:" >&2
    echo "  masjidpi-update verify BUNDLE SIGNATURE" >&2
    echo "  sudo masjidpi-update plan BUNDLE SIGNATURE" >&2
    echo "  sudo masjidpi-update install BUNDLE SIGNATURE" >&2
    exit 1
}

stable_version_key()
{
    local version=${1#v}

    if [[ ! "$version" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
        return 1
    fi

    printf '%010d%010d%010d\n' \
        "$((10#${BASH_REMATCH[1]}))" \
        "$((10#${BASH_REMATCH[2]}))" \
        "$((10#${BASH_REMATCH[3]}))"
}

verify_payload()
{
    local relative_path=$1
    local expected_size=$2
    local expected_sha256=$3
    local pathname="$extraction_dir/$relative_path"
    local actual_size
    local actual_sha256

    if [[ ! -f "$pathname" ]]; then
        echo "Missing payload: $relative_path" >&2
        return 1
    fi

    actual_size=$(stat -c '%s' "$pathname")
    actual_sha256=$(sha256sum "$pathname" | awk '{print $1}')

    if [[ "$actual_size" != "$expected_size" ]]; then
        echo "Size mismatch: $relative_path" >&2
        return 1
    fi

    if [[ "$actual_sha256" != "$expected_sha256" ]]; then
        echo "SHA-256 mismatch: $relative_path" >&2
        return 1
    fi

    echo "PASS  $relative_path"
}

if [[ "${1:-}" = install ]]; then
    if [[ $# -ne 3 ]]; then
        usage
    fi

    if [[ "$EUID" -ne 0 ]]; then
        echo "Run the install command with sudo." >&2
        exit 1
    fi

    bundle=$(realpath "$2")
    signature=$(realpath "$3")

    # Verification and all read-only targeting checks must pass before any
    # filesystem or boot data is changed.
    "$0" plan "$bundle" "$signature"

    running_source=$(findmnt -no SOURCE /)

    case "$running_source" in
        /dev/mmcblk0p2)
            running_slot=a
            target_slot=b
            target_partition=/dev/mmcblk0p3
            target_label=SYSTEM_B
            ;;
        /dev/mmcblk0p3)
            running_slot=b
            target_slot=a
            target_partition=/dev/mmcblk0p2
            target_label=SYSTEM_A
            ;;
        *)
            echo "Unsupported running root: $running_source" >&2
            exit 1
            ;;
    esac

    mapfile -t running_user_passwd_records < <(
        getent passwd "$appliance_user"
    )
    mapfile -t running_user_shadow_records < <(
        getent shadow "$appliance_user"
    )

    if (( ${#running_user_passwd_records[@]} != 1 ||
          ${#running_user_shadow_records[@]} != 1 )); then
        echo "Running system must contain exactly one $appliance_user account." >&2
        exit 1
    fi

    running_user_passwd=${running_user_passwd_records[0]}
    running_user_shadow=${running_user_shadow_records[0]}

    IFS=: read -r \
        running_user_name _ running_user_uid running_user_gid _ _ _ \
        <<<"$running_user_passwd"
    IFS=: read -r \
        running_shadow_name running_user_password_hash _ \
        <<<"$running_user_shadow"

    if [[ "$running_user_name" != "$appliance_user" ||
          "$running_shadow_name" != "$appliance_user" ||
          ! "$running_user_uid" =~ ^[0-9]+$ ||
          ! "$running_user_gid" =~ ^[0-9]+$ ||
          -z "$running_user_password_hash" ||
          "$running_user_password_hash" == '!'* ||
          "$running_user_password_hash" == '*'* ]]; then
        echo "Running $appliance_user account has no usable password identity." >&2
        exit 1
    fi

    staging_parent=/persistent/updates
    install -d -o root -g root -m 0700 "$staging_parent"
    staging_dir=$(mktemp -d "$staging_parent/install.XXXXXX")

    boot_was_read_only=0
    boot_dir="/boot/firmware/slots/$target_slot"
    target_root=""

    # shellcheck disable=SC2317
    cleanup_install()
    {
        if [[ -n "$target_root" ]]; then
            if mountpoint -q "$target_root"; then
                umount "$target_root" 2>/dev/null ||
                    true
            fi

            rmdir "$target_root" 2>/dev/null ||
                true
        fi

        rm -rf "$staging_dir"

        if [[ "$boot_was_read_only" -eq 1 ]]; then
            mount -o remount,ro /boot/firmware 2>/dev/null ||
                true
        fi
    }
    trap cleanup_install EXIT

    echo
    echo "=== EXTRACT VERIFIED PAYLOAD ==="
    zstd -dc "$bundle" |
    tar -xf - -C "$staging_dir"

    manifest="$staging_dir/manifest.json"
    release_version=$(
        jq -r '.release_version' "$manifest"
    )
    expected_rootfs_size=$(
        jq -r '.rootfs.uncompressed_size' "$manifest"
    )
    expected_rootfs_sha256=$(
        jq -r '.rootfs.uncompressed_sha256' "$manifest"
    )

    boot_options=$(findmnt -no OPTIONS /boot/firmware)

    if ! tr ',' '\n' <<<"$boot_options" |
        grep -Fqx rw; then
        mount -o remount,rw /boot/firmware
        boot_was_read_only=1
    fi

    install -d -o root -g root -m 0755 "$boot_dir"

    echo
    echo "=== STAGE TARGET BOOT FILES ==="

    for boot_file in \
        kernel8-uboot.img \
        initramfs8 \
        bcm2710-rpi-3-b.dtb
    do
        source_file="$staging_dir/boot/$boot_file"
        staged_file="$boot_dir/.$boot_file.masjidpi-update"

        install -o root -g root -m 0644 \
            "$source_file" \
            "$staged_file"

        expected_sha256=$(
            case "$boot_file" in
                kernel8-uboot.img)
                    jq -r '.boot.kernel.sha256' "$manifest"
                    ;;
                initramfs8)
                    jq -r '.boot.initramfs.sha256' "$manifest"
                    ;;
                bcm2710-rpi-3-b.dtb)
                    jq -r '.boot.dtb.sha256' "$manifest"
                    ;;
            esac
        )
        actual_sha256=$(
            sha256sum "$staged_file" |
            awk '{print $1}'
        )

        if [[ "$actual_sha256" != "$expected_sha256" ]]; then
            echo "Staged boot-file verification failed: $boot_file" >&2
            exit 1
        fi

        echo "PASS  $boot_file"
    done

    sync

    echo
    echo "=== WRITE INACTIVE ROOT FILESYSTEM ==="
    echo "Running slot: system_$running_slot"
    echo "Target slot:  system_$target_slot"
    echo "Target:       $target_partition"

    zstd -dc "$staging_dir/rootfs.ext4.zst" |
    dd \
        of="$target_partition" \
        bs=4M \
        conv=fsync \
        status=progress

    blockdev --flushbufs "$target_partition"

    echo
    echo "=== VERIFY WRITTEN ROOT FILESYSTEM ==="

    actual_rootfs_sha256=$(
        dd \
            if="$target_partition" \
            bs=16M \
            count="$expected_rootfs_size" \
            iflag=count_bytes \
            status=progress |
        sha256sum |
        awk '{print $1}'
    )

    if [[ "$actual_rootfs_sha256" != "$expected_rootfs_sha256" ]]; then
        echo "Written root filesystem SHA-256 mismatch." >&2
        exit 1
    fi

    echo "PASS  inactive root filesystem"

    # Ensure the two slots never retain duplicate filesystem UUIDs and restore
    # the correct human-readable label for the target partition.
    tune2fs -f -U random "$target_partition"
    e2label "$target_partition" "$target_label"

    if [[ "$(e2label "$target_partition")" != "$target_label" ]]; then
        echo "Unable to set target filesystem label." >&2
        exit 1
    fi

    echo "PASS  target label $target_label"

    echo
    echo "=== PRESERVE APPLIANCE IDENTITY ==="

    if ! grep -Eq '^[0-9a-f]{32}$' /etc/machine-id; then
        echo "Running system has an invalid machine ID." >&2
        exit 1
    fi

    shopt -s nullglob
    host_keys=(
        /etc/ssh/ssh_host_*_key
        /etc/ssh/ssh_host_*_key.pub
    )
    shopt -u nullglob

    if (( ${#host_keys[@]} == 0 )); then
        echo "Running system has no SSH host keys." >&2
        exit 1
    fi

    target_root=$(mktemp -d "$staging_parent/target-root.XXXXXX")
    mount "$target_partition" "$target_root"

    target_user_count=$(
        awk -F: -v user="$appliance_user" \
            '$1 == user { count++ } END { print count + 0 }' \
            "$target_root/etc/passwd"
    )
    target_shadow_count=$(
        awk -F: -v user="$appliance_user" \
            '$1 == user { count++ } END { print count + 0 }' \
            "$target_root/etc/shadow"
    )
    target_user_uid=$(
        awk -F: -v user="$appliance_user" \
            '$1 == user { print $3 }' \
            "$target_root/etc/passwd"
    )
    target_user_gid=$(
        awk -F: -v user="$appliance_user" \
            '$1 == user { print $4 }' \
            "$target_root/etc/passwd"
    )

    if [[ "$target_user_count" -ne 1 ||
          "$target_shadow_count" -ne 1 ||
          "$target_user_uid" != "$running_user_uid" ||
          "$target_user_gid" != "$running_user_gid" ||
          ! -x "$target_root/usr/sbin/chpasswd" ]]; then
        echo "Target system has an incompatible $appliance_user account." >&2
        exit 1
    fi

    install -o root -g root -m 0444 \
        /etc/machine-id \
        "$target_root/etc/machine-id"

    install -d -o root -g root -m 0755 \
        "$target_root/etc/ssh"

    cp -a \
        "${host_keys[@]}" \
        "$target_root/etc/ssh/"

    printf '%s:%s\n' \
        "$appliance_user" \
        "$running_user_password_hash" |
        chroot "$target_root" \
            /usr/sbin/chpasswd \
            --encrypted

    chown root:root \
        "$target_root"/etc/ssh/ssh_host_*_key \
        "$target_root"/etc/ssh/ssh_host_*_key.pub

    if ! cmp -s \
        /etc/machine-id \
        "$target_root/etc/machine-id"; then
        echo "Unable to preserve the machine ID." >&2
        exit 1
    fi

    for host_key in "${host_keys[@]}"
    do
        key_name=$(basename "$host_key")

        if ! cmp -s \
            "$host_key" \
            "$target_root/etc/ssh/$key_name"; then
            echo "Unable to preserve SSH host key: $key_name" >&2
            exit 1
        fi
    done

    target_user_password_hash=$(
        awk -F: -v user="$appliance_user" \
            '$1 == user { print $2 }' \
            "$target_root/etc/shadow"
    )

    if [[ "$target_user_password_hash" != "$running_user_password_hash" ]]; then
        echo "Unable to preserve the $appliance_user account password." >&2
        exit 1
    fi

    install -d -o root -g root -m 0755 \
        "$target_root/usr/share/masjidpi/update"

    install -o root -g root -m 0644 \
        "$manifest" \
        "$target_root/usr/share/masjidpi/update/release.json"

    if ! cmp -s \
        "$manifest" \
        "$target_root/usr/share/masjidpi/update/release.json"; then
        echo "Unable to record the target release identity." >&2
        exit 1
    fi

    sync
    umount "$target_root"
    rmdir "$target_root"
    target_root=""

    echo "PASS  machine ID"
    echo "PASS  SSH host keys"
    echo "PASS  $appliance_user account password"
    echo "PASS  release identity"

    echo
    echo "=== ACTIVATE TARGET BOOT FILES ==="

    for boot_file in \
        kernel8-uboot.img \
        initramfs8 \
        bcm2710-rpi-3-b.dtb
    do
        mv -f \
            "$boot_dir/.$boot_file.masjidpi-update" \
            "$boot_dir/$boot_file"
        echo "PASS  $boot_file"
    done

    sync

    install -o root -g root -m 0644 \
        "$manifest" \
        "$staging_parent/installed-${release_version}.json"

    echo
    echo "=== ARM TRIAL BOOT ==="

    # This is deliberately last. Any interruption before this point leaves
    # U-Boot selecting the currently confirmed system.
    masjidpi-ab trial "$target_slot"

    echo
    echo "RESULT: PASS — update installed into system_$target_slot"
    echo "Reboot when ready to begin the trial."
    exit 0
fi

if [[ "${1:-}" = plan ]]; then
    if [[ $# -ne 3 ]]; then
        usage
    fi

    if [[ "$EUID" -ne 0 ]]; then
        echo "Run the plan command with sudo." >&2
        exit 1
    fi

    bundle=$(realpath "$2")
    signature=$(realpath "$3")

    echo "=== VERIFY UPDATE BUNDLE ==="
    "$0" verify "$bundle" "$signature"

    manifest_json=$(
        zstd -dc "$bundle" |
        tar -xOf - manifest.json
    )

    candidate_version=$(
        jq -r '.release_version' <<<"$manifest_json"
    )
    candidate_commit=$(
        jq -r '.source_commit' <<<"$manifest_json"
    )

    current_release=/usr/share/masjidpi/update/release.json
    current_version=unrecorded

    if [[ -f "$current_release" ]]; then
        if ! jq -e '
            .schema_version == 1 and
            .product == "masjidpi" and
            .device_class == "pi3" and
            (.release_version | type == "string" and
                test("^[A-Za-z0-9][A-Za-z0-9._+-]*$")) and
            (.source_commit | type == "string" and
                test("^[0-9a-f]{40}$"))
        ' "$current_release" >/dev/null; then
            echo "Running release record is invalid." >&2
            exit 1
        fi

        current_version=$(
            jq -r '.release_version' "$current_release"
        )
        current_commit=$(
            jq -r '.source_commit' "$current_release"
        )

        if [[ "$candidate_version" == "$current_version" ]]; then
            echo "Release $candidate_version is already running." >&2
            exit 1
        fi

        if [[ "$candidate_commit" == "$current_commit" ]]; then
            echo "The bundle contains the currently running build." >&2
            echo "Current version:   $current_version" >&2
            echo "Candidate version: $candidate_version" >&2
            exit 1
        fi

        candidate_stable_key=$(
            stable_version_key "$candidate_version" ||
            true
        )
        current_stable_key=$(
            stable_version_key "$current_version" ||
            true
        )

        if [[ -n "$candidate_stable_key" &&
              -n "$current_stable_key" &&
              "$candidate_stable_key" < "$current_stable_key" ]]; then
            echo "Refusing release downgrade." >&2
            echo "Current version:   $current_version" >&2
            echo "Candidate version: $candidate_version" >&2
            exit 1
        fi
    fi

    running_source=$(findmnt -no SOURCE /)

    case "$running_source" in
        /dev/mmcblk0p2)
            running_slot=a
            target_slot=b
            target_partition=/dev/mmcblk0p3
            ;;
        /dev/mmcblk0p3)
            running_slot=b
            target_slot=a
            target_partition=/dev/mmcblk0p2
            ;;
        *)
            echo "Unsupported running root: $running_source" >&2
            exit 1
            ;;
    esac

    if [[ ! -b "$target_partition" ]]; then
        echo "Inactive partition not found: $target_partition" >&2
        exit 1
    fi

    if findmnt -rn -S "$target_partition" >/dev/null; then
        echo "Inactive partition is mounted: $target_partition" >&2
        exit 1
    fi

    expected_rootfs_size=$(
        jq -r '.rootfs.uncompressed_size' <<<"$manifest_json"
    )
    target_partition_size=$(
        blockdev --getsize64 "$target_partition"
    )

    if [[ "$target_partition_size" != "$expected_rootfs_size" ]]; then
        echo "Inactive partition size does not match the update image." >&2
        echo "Expected: $expected_rootfs_size" >&2
        echo "Found:    $target_partition_size" >&2
        exit 1
    fi

    persistent_source=$(findmnt -no SOURCE /persistent)
    persistent_options=$(findmnt -no OPTIONS /persistent)

    if [[ "$persistent_source" != /dev/mmcblk0p4 ]]; then
        echo "Unexpected persistent partition: $persistent_source" >&2
        exit 1
    fi

    if ! tr ',' '\n' <<<"$persistent_options" |
        grep -Fqx rw; then
        echo "Persistent storage is not read-write." >&2
        exit 1
    fi

    upgrade_available=$(
        fw_printenv -n upgrade_available 2>/dev/null ||
        true
    )

    if [[ "$upgrade_available" != 0 ]]; then
        echo "Another A/B trial is already pending." >&2
        exit 1
    fi

    bootlimit=$(
        fw_printenv -n bootlimit 2>/dev/null ||
        true
    )

    if [[ -n "$bootlimit" ]]; then
        echo "Unexpected bootlimit exists in stable state." >&2
        exit 1
    fi

    boot_required=$(
        jq '
            .boot.kernel.size +
            .boot.initramfs.size +
            .boot.dtb.size
        ' <<<"$manifest_json"
    )
    boot_available=$(
        df -B1 --output=avail /boot/firmware |
        tail -n 1 |
        tr -d ' '
    )

    if (( boot_available < boot_required )); then
        echo "Insufficient BOOT free space for atomic replacement." >&2
        echo "Required:  $boot_required" >&2
        echo "Available: $boot_available" >&2
        exit 1
    fi

    echo
    echo "=== UPDATE PLAN ==="
    echo "Current version:  $current_version"
    echo "Target version:   $candidate_version"
    echo "Running slot:     system_$running_slot"
    echo "Target slot:      system_$target_slot"
    echo "Target partition: $target_partition"
    echo "Rootfs bytes:     $expected_rootfs_size"
    echo "BOOT required:    $boot_required"
    echo "BOOT available:   $boot_available"
    echo
    echo "RESULT: PASS — update can be safely staged"
    exit 0
fi

if [[ "${1:-}" != verify || $# -ne 3 ]]; then
    usage
fi

bundle=$(realpath "$2")
signature=$(realpath "$3")
readonly bundle
readonly signature

for command_name in \
    jq \
    minisign \
    realpath \
    sha256sum \
    stat \
    tar \
    zstd
do
    if ! command -v "$command_name" >/dev/null; then
        echo "Required command not found: $command_name" >&2
        exit 1
    fi
done

for required_file in \
    "$public_key" \
    "$bundle" \
    "$signature"
do
    if [[ ! -f "$required_file" ]]; then
        echo "Required file not found: $required_file" >&2
        exit 1
    fi
done

echo "=== SIGNATURE ==="
minisign \
    -Vm "$bundle" \
    -x "$signature" \
    -p "$public_key"

expected_contents=$(
    printf '%s\n' \
        boot/ \
        boot/bcm2710-rpi-3-b.dtb \
        boot/initramfs8 \
        boot/kernel8-uboot.img \
        manifest.json \
        rootfs.ext4.zst |
    sort
)
readonly expected_contents

actual_contents=$(
    zstd -dc "$bundle" |
    tar -tf - |
    sort
)

if [[ "$actual_contents" != "$expected_contents" ]]; then
    echo "Unexpected bundle contents:" >&2
    diff -u \
        <(printf '%s\n' "$expected_contents") \
        <(printf '%s\n' "$actual_contents") >&2 ||
        true
    exit 1
fi

echo "PASS  bundle contents"

# Keep verification extraction beside the downloaded bundle. Appliance
# downloads live on PERSISTENT storage, while /tmp is a small RAM-backed
# filesystem that cannot hold both the bundle and its extracted payload.
extraction_parent=$(dirname "$bundle")
extraction_dir=$(mktemp -d "$extraction_parent/.verify.XXXXXX")

cleanup()
{
    rm -rf "$extraction_dir"
}
trap cleanup EXIT

zstd -dc "$bundle" |
tar -xf - -C "$extraction_dir"

readonly manifest="$extraction_dir/manifest.json"

if ! jq -e '
    .schema_version == 1 and
    .product == "masjidpi" and
    .device_class == "pi3" and
    (.release_version | type == "string" and
        test("^[A-Za-z0-9][A-Za-z0-9._+-]*$")) and
    (.source_commit | type == "string" and
        test("^[0-9a-f]{40}$")) and
    .rootfs.file == "rootfs.ext4.zst" and
    .rootfs.compression == "zstd" and
    .boot.kernel.file == "boot/kernel8-uboot.img" and
    .boot.initramfs.file == "boot/initramfs8" and
    .boot.dtb.file == "boot/bcm2710-rpi-3-b.dtb"
' "$manifest" >/dev/null; then
    echo "Invalid or unsupported update manifest." >&2
    exit 1
fi

echo "PASS  manifest schema"

echo
echo "=== PAYLOADS ==="

verify_payload \
    "$(jq -r '.rootfs.file' "$manifest")" \
    "$(jq -r '.rootfs.archive_size' "$manifest")" \
    "$(jq -r '.rootfs.archive_sha256' "$manifest")"

for component in kernel initramfs dtb
do
    verify_payload \
        "$(jq -r ".boot.$component.file" "$manifest")" \
        "$(jq -r ".boot.$component.size" "$manifest")" \
        "$(jq -r ".boot.$component.sha256" "$manifest")"
done

echo
echo "=== ROOT FILESYSTEM ==="

actual_rootfs_size=$(
    zstd -dc "$extraction_dir/rootfs.ext4.zst" |
    wc -c
)
actual_rootfs_sha256=$(
    zstd -dc "$extraction_dir/rootfs.ext4.zst" |
    sha256sum |
    awk '{print $1}'
)

expected_rootfs_size=$(
    jq -r '.rootfs.uncompressed_size' "$manifest"
)
expected_rootfs_sha256=$(
    jq -r '.rootfs.uncompressed_sha256' "$manifest"
)

if [[ "$actual_rootfs_size" != "$expected_rootfs_size" ]]; then
    echo "Decompressed root filesystem size mismatch." >&2
    exit 1
fi

if [[ "$actual_rootfs_sha256" != "$expected_rootfs_sha256" ]]; then
    echo "Decompressed root filesystem SHA-256 mismatch." >&2
    exit 1
fi

echo "PASS  decompressed root filesystem"
echo
echo "RESULT: PASS — trusted MasjidPi update bundle"
echo "Version: $(jq -r '.release_version' "$manifest")"
echo "Commit:  $(jq -r '.source_commit' "$manifest")"
