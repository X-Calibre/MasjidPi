[Unit]
Description=MasjidFrame MasjidBoard WebKit Warm-up
# Keep Plymouth on screen while WPE/WebKit performs its expensive cold start.
# The real DRM display service is ordered after plymouth-quit.service.
Before=plymouth-quit.service
ConditionPathExists=/opt/masjidframe/frontend/masjidboard-startup.html

[Service]
Type=oneshot
User=root
Environment=MASJIDFRAME_HOME=/opt/masjidframe
ExecStart=/opt/masjidframe/bin/masjidboard-warmup
TimeoutStartSec=25

[Install]
WantedBy=multi-user.target
