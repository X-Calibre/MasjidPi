[Unit]
Description=MasjidFrame Internet Radio
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple

User=root
WorkingDirectory=/opt/masjidframe
RuntimeDirectory=masjidframe
RuntimeDirectoryMode=0755

Environment=MASJIDFRAME_HOME=/opt/masjidframe
EnvironmentFile=-/etc/masjidframe/components.env

ExecStart=/opt/masjidframe/bin/masjidframe

Restart=always
RestartSec=5

# Protect the SD card from runaway journal writes during persistent failures.
# Normal application logs remain available, but bursts are rate-limited by systemd.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=20

[Install]
WantedBy=multi-user.target
