# MasjidPi appliance boot splash.
# The validated 7-inch appliance panel is physically mounted in portrait while
# KMS exposes its native 1024x600 landscape mode. Use a pre-rotated splash asset
# so Plymouth never has to rotate a non-square image at runtime; that operation
# cropped the left and right sides of the temporary wordmark on real hardware.

Window.SetBackgroundTopColor(0.02, 0.06, 0.05);
Window.SetBackgroundBottomColor(0.01, 0.02, 0.02);

brand.image = Image("masjidpi-splash-logo-appliance.png");

# The pre-rotated asset is 567x960. Fit it comfortably inside the native
# 1024x600 framebuffer while preserving its aspect ratio. When the physical
# panel is viewed in portrait, this corresponds to the intended upright logo.
max_width = Window.GetWidth() * 0.70;
max_height = Window.GetHeight() * 0.70;
scale = 1.0;

if (brand.image.GetWidth() > max_width)
    scale = max_width / brand.image.GetWidth();
if (brand.image.GetHeight() * scale > max_height)
    scale = max_height / brand.image.GetHeight();

if (scale < 1.0)
    brand.image = brand.image.Scale(brand.image.GetWidth() * scale, brand.image.GetHeight() * scale);

brand.sprite = Sprite(brand.image);

fun position_splash() {
    center_x = Window.GetX() + Window.GetWidth() / 2;
    center_y = Window.GetY() + Window.GetHeight() / 2;

    brand.sprite.SetX(center_x - brand.image.GetWidth() / 2);
    brand.sprite.SetY(center_y - brand.image.GetHeight() / 2);
    brand.sprite.SetZ(1000);
}

fun refresh_callback() {
    position_splash();
}

position_splash();
Plymouth.SetRefreshFunction(refresh_callback);
