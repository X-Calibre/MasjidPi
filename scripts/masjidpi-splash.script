# MasjidPi appliance boot splash.
# The validated 7-inch appliance panel is physically mounted in portrait while
# KMS exposes its native 1024x600 landscape mode. Scale the supplied logo while
# it is still in native orientation, then rotate it for the portrait panel.

Window.SetBackgroundTopColor(0.02, 0.06, 0.05);
Window.SetBackgroundBottomColor(0.01, 0.02, 0.02);

brand.image = Image("masjidpi-splash-logo.png");

# On the 1024x600 KMS framebuffer, the physical portrait width corresponds to
# the framebuffer height. Size the logo to 65% of that dimension before
# rotating it. This avoids Plymouth's rotated-image sizing ambiguity and keeps
# the full temporary wordmark comfortably inside the visible portrait area.
target_width = Window.GetHeight() * 0.65;
scale = target_width / brand.image.GetWidth();

if (scale < 1.0)
    brand.image = brand.image.Scale(brand.image.GetWidth() * scale, brand.image.GetHeight() * scale);

brand.image = brand.image.Rotate(-Math.Pi / 2);
brand.sprite = Sprite(brand.image);

fun position_splash() {
    center_x = Window.GetX() + Window.GetWidth() / 2;
    center_y = Window.GetY() + Window.GetHeight() / 2;

    brand.sprite.SetX(center_x - brand.image.GetWidth() / 2);
    brand.sprite.SetY(center_y - brand.image.GetHeight() / 2);
    brand.sprite.SetZ(1000);
}

fun refresh_callback() {
    position_splash();
}

position_splash();
Plymouth.SetRefreshFunction(refresh_callback);
