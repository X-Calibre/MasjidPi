[Unit]
Description=MasjidPi Internet Radio
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple

User=root
WorkingDirectory=/opt/masjidpi

Environment=MASJIDPI_HOME=/opt/masjidpi

ExecStart=/opt/masjidpi/bin/masjidpi

Restart=always
RestartSec=5

# Protect the SD card from runaway journal writes during persistent failures.
# Normal application logs remain available, but bursts are rate-limited by systemd.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=20

[Install]
WantedBy=multi-user.target
